# Copy to .env and fill in. .env is gitignored; never commit real values.

# Anthropic API key. The SDK also accepts an `ant auth login` profile instead,
# in which case leave this unset.
ANTHROPIC_API_KEY=

# Postgres (defaults to ops/docker-compose.yml).
DATABASE_URL=postgresql+psycopg://tutor:tutor@localhost:5433/tutor

# DESTRUCTIVE. The migration tests drop and recreate every table here to
# exercise migrations from empty, so this must be a throwaway database — never
# the one in DATABASE_URL. The tests refuse to run unless the name ends in
# `_test`; docker-compose creates `tutor_test` for exactly this.
TEST_DATABASE_URL=postgresql+psycopg://tutor:tutor@localhost:5433/tutor_test
